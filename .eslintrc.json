{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "globals": {
    "bootstrap": "readonly",
    "Chart": "readonly",
    "ShopApp": "readonly"
  },
  "overrides": [
    {
      "files": ["api/**/*.js"],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn"
  }
}
